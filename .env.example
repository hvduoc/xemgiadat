# Pi Network Integration Environment Variables
# SECURITY NOTICE: Never commit actual values to git!

# =============================================================================
# PI NETWORK CREDENTIALS (Get from https://develop.pi/)
# =============================================================================

# Public App Identifier (safe to expose in frontend)
PI_APP_ID=your_pi_app_id_here

# CRITICAL SECRETS (NEVER expose to client-side)
PI_APP_SECRET=your_pi_app_secret_here
PI_PLATFORM_API_KEY=your_platform_api_key_here

# =============================================================================
# DEPLOYMENT ENVIRONMENT
# =============================================================================
NODE_ENV=development
# NODE_ENV=production

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Copy this file to .env for local development
# 2. Never commit .env to git (already in .gitignore)
# 3. Set environment variables in Netlify dashboard for production
# 4. Use different credentials for sandbox vs production
# 5. Rotate secrets regularly (monthly recommended)
# 6. Monitor access logs for suspicious activity

# =============================================================================
# SANDBOX vs PRODUCTION
# =============================================================================
# Sandbox (Development):
# PI_APP_ID=sandbox_app_id
# PI_APP_SECRET=sandbox_app_secret
# PI_PLATFORM_API_KEY=sandbox_platform_key

# Production:
# PI_APP_ID=prod_app_id
# PI_APP_SECRET=prod_app_secret
# PI_PLATFORM_API_KEY=prod_platform_key