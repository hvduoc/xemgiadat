# Local Netlify folder
.netlify

# ================================================================
# PI NETWORK SECURITY - CRITICAL ENVIRONMENT PROTECTION
# ================================================================

# Environment variables and secrets
.env
.env.local
.env.production
.env.development
.env.*.local

# Pi Network credentials
pi-credentials.json
pi-app-secret.txt
platform-api-key.txt

# Other sensitive configuration
config/secrets.js
src/config/private.js
secrets/
*.key
*.pem
*.p12
*.pfx

# Backup files that might contain secrets
*.backup
*.bak
*.old

# ================================================================
# XEMGIADAT DATA PROCESSING - GIT OPTIMIZATION
# ================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
ENV/

# Data Processing - Large Files
sample-data/
processing-data/
test-data/
data-input/
data-output/

# CAD Files (Large Binary)
*.dwg
*.dxf
*.dgn

# Image Files (Large Binary) 
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.gif
*.svg

# Processed Outputs
**/output/
**/processed/
**/results/
**/*_processed.*
**/*_report.*
**/*_metadata.*
**/*.geojson

# Logs
*.log
logs/
debug.log
processing.log

# Temporary Files
tmp/
temp/
.temp/
cache/

# OS Generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# VS Code - but track repo-wide settings
.vscode/*
!.vscode/settings.json

# Node Modules
node_modules/

# Vite build outputs
dist/
.vite/

# Development logs and temp
dev-server.log
*.log
*.tmp

# Optional: exclude sourcemaps to reduce repo size
# Comment this line if you decide to keep maps for debugging
*.map

# But exclude essential samples (small ones only)
!sample-data/output/euro_village_2_sample.geojson
